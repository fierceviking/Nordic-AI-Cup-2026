[Unit]
Description=Nordic AI Cup survival-simulator agent endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
WorkingDirectory=/opt/agent
# Port 80 keeps the submitted URL free of a port suffix. Single worker on
# purpose: the Hive holds per-run state in memory, so a second worker would
# see half the ticks and dead-reckon from a broken map.
ExecStart=/opt/agent/.venv/bin/uvicorn agent_server:app \
    --host 0.0.0.0 --port 80 --workers 1 --log-level warning \
    --timeout-keep-alive 75
# The evaluation runs three simulations back to back; never die between them.
Restart=always
RestartSec=1
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
